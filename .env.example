# Impala airtime provider configuration
AIRTIME_PROVIDER_BASE_URL=https://airtime.impalapay.com
AIRTIME_PROVIDER_TOKEN_PATH=/api/auth/token
# Set this to the provider's documented reserve-purchase path.
AIRTIME_PROVIDER_PURCHASE_PATH=/deposit
AIRTIME_PROVIDER_SEND_PATH=/send
AIRTIME_API_KEY=replace_me
AIRTIME_API_SECRET=replace_me
AIRTIME_PROVIDER_PAYBILL=4042061
AIRTIME_PROVIDER_ACCOUNT_NUMBER=YOUR_JASIRI_WALLET_ACCOUNT
AIRTIME_PROVIDER_CUSTOMER_EMAIL=operations@example.com
AIRTIME_PROVIDER_TIMEOUT_SECONDS=20

# Cardano AIRT native asset
CARDANO_AIRT_POLICY_ID=replace_me
CARDANO_AIRT_POLICY_SIGNING_KEY=replace_me
CARDANO_AIRT_ASSET_NAME=AIRT
CARDANO_AIRT_DECIMALS=0

# Comet Engine (docs.mamlakapsp.com) — IMM / AMM / tokenization
# Confirmed live on production (cometpayments.mamlakapsp.com) as of
# 2026-09-11: /health, /swap/quote+pools (Celo AMM), /imm/quote,
# /admin/imm/rates+vault+exposure, /admin/corridor/nodes, /admin/risk/pnl —
# all accept just X-API-Key/X-API-Secret, no X-Service-Token needed.
# Confirmed NOT deployed here: /assets, /chains, /tokenize/airtime (404).
COMET_BASE_URL=https://cometpayments.mamlakapsp.com
COMET_TENANT_SLUG=comet
COMET_API_KEY=replace_me
COMET_API_SECRET=replace_me
COMET_SERVICE_TOKEN=replace_me

# ZIGRAM / Transact Comply (transaction monitoring) -- see routes/ramp.py::_screen_ramp_transaction
ZIGRAM_BASE_URL=https://qa.transactcomply.com/tmprocessor/tp/
ZIGRAM_USERNAME=replace_me
ZIGRAM_USER_SECRET=replace_me
ZIGRAM_PROJECT_ID=replace_me
ZIGRAM_CLEAR_STATUSES=

# --- Payment-gateway callback authentication (REQUIRED outside local dev) -----------------------------
# Callbacks that credit wallets are refused unless authenticated. Configure ONE of the two (or both):
#   HMAC: the gateway signs the raw body as "X-Mamlaka-Signature: sha256=<hex HMAC-SHA256>".
AIRTEL_CALLBACK_AUTH_ENABLED=true
AIRTEL_CALLBACK_SIGNATURE_HEADER=X-Mamlaka-Signature
AIRTEL_CALLBACK_HASH_KEY=<the signing secret the gateway gave you for this merchant>
#   Shared token (gateways that cannot sign): appended to the callback URL we hand the gateway.
# AIRTEL_CALLBACK_TOKEN=<long random string>
# Local development only (ignored when APP_ENV=production): accept callbacks with neither.
# ALLOW_UNAUTHENTICATED_CALLBACKS=true

# --- Virtual cards (Mamlaka Partner API) --------------------------------------------------------------
CARD_FEATURE_ENABLED=true
MAMLAKA_CARDS_BASE_URL=https://<mamlaka cards host>/api/v1/partner
MAMLAKA_CARDS_API_KEY=<partner API key from Mamlaka (mk_live_...)>
MAMLAKA_CARDS_WEBHOOK_SECRET=<webhook signing secret from Mamlaka (whsec_...)>
CARD_TYPE_ID=111078
CARD_MARGIN_PCT=2.0
CARD_MIN_USD=10
CARD_MAX_USD=50
